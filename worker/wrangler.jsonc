{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiebalite-content-analysis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "tiebalite-content-analysis.liop.xyz",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "vars": {
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
